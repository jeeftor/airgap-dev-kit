#!/bin/bash

# Air-Gap Development Kit CLI Wrapper
# Provides unified interface for managing the airgap-dev-kit

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Kit information
KIT_NAME="Air-Gap Development Kit"
KIT_VERSION="unknown"
COMMAND_NAME="airgap-dev-kit"

# Detect installation directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_LOG="$HOME/.airgap-dev-kit-install.log"
KIT_DIR="$(dirname "$SCRIPT_DIR")"

if [[ -f "$INSTALL_LOG" ]]; then
    LOG_KIT_DIR=$(awk -F'[|=]' '$1 == "METADATA" && $2 == "KIT_DIR" { print $3; exit }' "$INSTALL_LOG")
    if [[ -n "$LOG_KIT_DIR" && -f "$LOG_KIT_DIR/install.sh" ]]; then
        KIT_DIR="$LOG_KIT_DIR"
    fi
fi

if [[ ! -f "$KIT_DIR/install.sh" && -f "$PWD/install.sh" ]]; then
    KIT_DIR="$PWD"
fi

# Load version if available
if [[ -f "$KIT_DIR/VERSION" ]]; then
    KIT_VERSION=$(cat "$KIT_DIR/VERSION")
fi

# Installation paths (check both possible locations)
INSTALL_PATHS=("$HOME/.local/bin" "$HOME/bin" "/usr/local/bin")
BIN_DIR=""

for path in "${INSTALL_PATHS[@]}"; do
    if [[ -f "$path/airgap" ]] || [[ -f "$path/$COMMAND_NAME" ]]; then
        BIN_DIR="$path"
        break
    fi
done

# Detect OS for platform-specific behavior
OS_TYPE=$(uname -s)
if [[ "$OS_TYPE" == "Darwin" ]]; then
    echo -e "${RED}[ERROR]${NC} macOS is not supported by this kit. This repository targets Linux installs."
    exit 1
else
    PLATFORM="linux"
fi

# Check if gum is available
GUM_AVAILABLE=false
if command -v gum >/dev/null 2>&1; then
    GUM_AVAILABLE=true
fi

is_interactive() {
    [[ -t 0 && -t 1 ]]
}

can_use_gum_prompts() {
    [[ "$GUM_AVAILABLE" == true ]] && is_interactive
}

gum_command() {
    local gum_path
    gum_path=$(command -v gum 2>/dev/null || true)
    [[ -n "$gum_path" && -x "$gum_path" ]] || return 1
    printf '%s\n' "$gum_path"
}

# Function to print colored output
print_status() {
    local gum_path
    if [[ "$GUM_AVAILABLE" == true ]] && gum_path=$(gum_command); then
        "$gum_path" style --foreground=green "✓ $1"
    else
        echo -e "${GREEN}[INFO]${NC} $1"
    fi
}

print_warning() {
    local gum_path
    if [[ "$GUM_AVAILABLE" == true ]] && gum_path=$(gum_command); then
        "$gum_path" style --foreground=yellow "⚠ $1"
    else
        echo -e "${YELLOW}[WARN]${NC} $1"
    fi
}

print_error() {
    local gum_path
    if [[ "$GUM_AVAILABLE" == true ]] && gum_path=$(gum_command); then
        "$gum_path" style --foreground=red "✗ $1"
    else
        echo -e "${RED}[ERROR]${NC} $1"
    fi
}

print_header() {
    local gum_path
    if [[ "$GUM_AVAILABLE" == true ]] && gum_path=$(gum_command); then
        "$gum_path" style --foreground=blue --border=double --padding="1 2" --margin="1 0" "$1"
    else
        echo -e "${BLUE}$1${NC}"
    fi
}

# Function to show progress with gum
show_progress() {
    local title="$1"
    local duration="${2:-3}"
    
    if [[ "$GUM_AVAILABLE" == true ]]; then
        gum spin --spinner dot --title "$title" -- sleep "$duration"
    else
        echo "$title..."
        sleep "$duration"
    fi
}

# Function to confirm with gum
confirm_action() {
    local message="$1"
    
    if can_use_gum_prompts; then
        gum confirm "$message"
    else
        echo -n "$message (y/N): "
        read -r response
        [[ "$response" =~ ^[Yy]$ ]]
    fi
}

# Function to show help
show_help() {
    cat << EOF
$KIT_NAME CLI Wrapper v$KIT_VERSION

Usage: $COMMAND_NAME <command> [options]

Commands:
    version     Show kit version and installation info
    check-update    Check the latest published kit release (read-only)
    download-release Download and checksum-verify the latest Linux release
    apply-release   Verify, extract, and install a downloaded release
    update [--yes]  Check, download, verify, and apply a published release
    doctor          Report installed tools, shell setup, and Neovim/LazyVim health (read-only)
    refresh-sources Refresh maintainer source binaries with make update
    install     Install missing tools from offline packages
    remove      Completely uninstall the airgap-dev-kit
    status      Show installation status of all tools
    help        Show this help message

Examples:
    $COMMAND_NAME version     # Show version info
    $COMMAND_NAME update      # Safely update from a published release
    $COMMAND_NAME doctor      # Check tools, shell setup, Neovim, LazyVim, and Mason
    $COMMAND_NAME install      # Install from offline packages
    $COMMAND_NAME status      # Check what's installed
    $COMMAND_NAME remove       # Uninstall everything

For more information, see the documentation at:
https://github.com/jeeftor/airgap-dev-kit
EOF
}

# Function to show version
show_version() {
    print_header "$KIT_NAME"
    
    if [[ "$GUM_AVAILABLE" == true ]]; then
        echo ""
        gum style --foreground=212 "Version:" "$KIT_VERSION"
        gum style --foreground=212 "Installation Directory:" "$KIT_DIR"
        
        if [[ -n "$BIN_DIR" ]]; then
            gum style --foreground=212 "Binary Directory:" "$BIN_DIR"
        else
            print_warning "Binary directory not found in standard paths"
        fi
        
        echo ""
        gum style --foreground=99 --bold "System Information:"
        gum style --foreground=212 "  OS:" "$(uname -s)"
        gum style --foreground=212 "  Arch:" "$(uname -m)"
        gum style --foreground=212 "  Shell:" "$SHELL"
        
        if [[ -d "$KIT_DIR/offline-packages" ]]; then
            gum style --foreground=212 "  Offline packages:" "Available"
        else
            gum style --foreground=212 "  Offline packages:" "Not found"
        fi
        
        if [[ "$GUM_AVAILABLE" == true ]]; then
            gum style --foreground=46 "✓ Gum UI enhancements available"
        else
            gum style --foreground=245 "  Gum UI: Not available (basic output only)"
        fi
    else
        echo "Version: $KIT_VERSION"
        echo "Installation Directory: $KIT_DIR"
        
        if [[ -n "$BIN_DIR" ]]; then
            echo "Binary Directory: $BIN_DIR"
        else
            print_warning "Binary directory not found in standard paths"
        fi
        
        echo ""
        echo "System Information:"
        echo "  OS: $(uname -s)"
        echo "  Arch: $(uname -m)"
        echo "  Shell: $SHELL"
        
        if [[ -d "$KIT_DIR/offline-packages" ]]; then
            echo "  Offline packages: Available"
        else
            echo "  Offline packages: Not found"
        fi
    fi
}

release_helper() {
    local helper="$KIT_DIR/scripts/release-update.sh"
    [[ -x "$helper" ]] || { print_error "Verified release updater is unavailable in $KIT_DIR"; exit 1; }
    printf '%s\n' "$helper"
}

check_update() {
    "$(release_helper)" check
}

download_release() {
    "$(release_helper)" download "$@"
}

apply_release() {
    "$(release_helper)" apply "$@"
}

update_release() {
    local assume_yes=false temp_dir
    [[ "${1:-}" == "--yes" ]] && assume_yes=true
    if [[ "$assume_yes" != true && ! -t 0 ]]; then
        print_error "Non-interactive updates require --yes."
        exit 2
    fi
    print_header "Verified Air-Gap Dev Kit Update"
    check_update
    if [[ "$assume_yes" != true ]] && ! confirm_action "Download, verify, and install the published release?"; then
        print_warning "Update cancelled."
        return 0
    fi
    temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/airgap-dev-kit-release.XXXXXX")
    trap 'rm -rf "$temp_dir"' RETURN
    download_release --dir "$temp_dir"
    apply_release --archive "$temp_dir/airgap-dev-kit-linux-x86_64.tar.gz" --checksums "$temp_dir/checksums.txt"
    trap - RETURN
}

refresh_sources() {
    print_header "Maintainer Source Refresh"
    [[ -f "$KIT_DIR/Makefile" ]] || { print_error "Makefile not found."; exit 1; }
    if ! confirm_action "Refresh individual upstream source binaries with make update?"; then
        print_warning "Source refresh cancelled."
        return 0
    fi
    (cd "$KIT_DIR" && make update && make verify)
    print_status "Source binaries refreshed and verified."
}

doctor() {
    local data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
    local config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
    local state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
    local nvim_config="$config_home/nvim"
    local nvim_data="$data_home/nvim"
    local mason_dir="$nvim_data/mason"
    local nvim_runtime="$nvim_data/runtime"
    local install_log="$HOME/.airgap-dev-kit-install.log"
    local failures=0 warnings=0 checked_binaries=0 startup_output

    doctor_error() {
        print_error "$1"
        failures=$((failures + 1))
    }

    doctor_warning() {
        print_warning "$1"
        warnings=$((warnings + 1))
    }

    check_shell_rc() {
        local shell_name="$1" rc_file="$2" binding_ext="$3" zoxide_init starship_init zoxide_line starship_line
        [[ -f "$rc_file" ]] || { doctor_warning "$shell_name setup: $rc_file is not present"; return; }

        if [[ "$shell_name" == "bash" ]]; then
            bash -n "$rc_file" && print_status "$shell_name setup: syntax is valid" || doctor_error "$shell_name setup: syntax error in $rc_file"
        elif command -v zsh >/dev/null 2>&1; then
            zsh -n "$rc_file" && print_status "$shell_name setup: syntax is valid" || doctor_error "$shell_name setup: syntax error in $rc_file"
        else
            doctor_warning "$shell_name setup: zsh is unavailable, skipped syntax check"
        fi

        if [[ -d "$HOME/.fzf/shell" ]]; then
            for integration in "key-bindings.$binding_ext" "completion.$binding_ext"; do
                if [[ -f "$HOME/.fzf/shell/$integration" ]] && rg -Fq "source ~/.fzf/shell/$integration" "$rc_file"; then
                    print_status "$shell_name fzf $integration enabled"
                else
                    doctor_error "$shell_name fzf $integration missing from $rc_file or ~/.fzf/shell"
                fi
            done
        fi

        zoxide_init="eval \"\$(zoxide init $shell_name)\""
        if [[ -x "${BIN_DIR:-$HOME/.local/bin}/zoxide" ]]; then
            rg -Fq "$zoxide_init" "$rc_file" && print_status "$shell_name zoxide integration enabled" || doctor_error "$shell_name zoxide integration missing from $rc_file"
        fi
        starship_init="eval \"\$(starship init $shell_name)\""
        if [[ -x "${BIN_DIR:-$HOME/.local/bin}/starship" ]]; then
            rg -Fq "$starship_init" "$rc_file" && print_status "$shell_name Starship integration enabled" || doctor_error "$shell_name Starship integration missing from $rc_file"
        fi
        if rg -Fq "$zoxide_init" "$rc_file" && rg -Fq "$starship_init" "$rc_file"; then
            zoxide_line=$(rg -nF "$zoxide_init" "$rc_file" | tail -1 | cut -d: -f1)
            starship_line=$(rg -nF "$starship_init" "$rc_file" | tail -1 | cut -d: -f1)
            if [[ "$zoxide_line" -gt "$starship_line" ]]; then
                print_status "$shell_name initializer order: Starship before zoxide"
            else
                doctor_error "$shell_name initializer order is wrong: place zoxide after Starship at the end of $rc_file"
            fi
        fi
        if [[ -d "$nvim_runtime" ]]; then
            rg -Fq 'export VIMRUNTIME="$HOME/.local/share/nvim/runtime"' "$rc_file" && print_status "$shell_name VIMRUNTIME configured" || doctor_error "$shell_name VIMRUNTIME missing from $rc_file"
        fi
    }

    print_header "Air-Gap Dev Kit Doctor"
    if [[ "$(uname -s)" == "Linux" ]]; then print_status "Linux host detected"; else print_error "Linux is required"; failures=$((failures + 1)); fi
    if [[ -f "$KIT_DIR/VERSION" ]]; then print_status "Kit version: $KIT_VERSION"; else print_error "Kit VERSION file missing"; failures=$((failures + 1)); fi
    if [[ -f "$KIT_DIR/config/plugin-manifest.lua" ]]; then print_status "Plugin manifest found"; else doctor_error "Plugin manifest missing"; fi

    echo ""
    echo "Installed binaries:"
    if [[ -f "$install_log" ]] && rg -q '^BINARY\|' "$install_log"; then
        while IFS='|' read -r type path _; do
            [[ "$type" == "BINARY" ]] || continue
            checked_binaries=$((checked_binaries + 1))
            [[ -x "$path" ]] && print_status "$(basename "$path"): $path" || doctor_error "$(basename "$path") missing or not executable: $path"
        done < <(awk -F'|' '!seen[$2]++ && $1 == "BINARY" { print }' "$install_log")
    else
        doctor_warning "No installed-binary records in $install_log; rerun install to record the exact package set"
    fi
    [[ $checked_binaries -gt 0 ]] && print_status "Checked $checked_binaries installed binaries"

    echo ""
    echo "Shell configuration:"
    check_shell_rc bash "$HOME/.bashrc" bash
    check_shell_rc zsh "$HOME/.zshrc" zsh

    echo ""
    echo "Neovim and LazyVim:"
    [[ -x "${BIN_DIR:-$HOME/.local/bin}/nvim" ]] && print_status "Neovim binary: ${BIN_DIR:-$HOME/.local/bin}/nvim" || doctor_error "Neovim binary missing from ${BIN_DIR:-$HOME/.local/bin}"
    [[ -f "$nvim_config/init.lua" ]] && print_status "Neovim config entry point: $nvim_config/init.lua" || doctor_error "Neovim config entry point missing: $nvim_config/init.lua"
    [[ -f "$nvim_config/lua/config/lazy.lua" ]] && print_status "LazyVim bootstrap config: $nvim_config/lua/config/lazy.lua" || doctor_error "LazyVim bootstrap config missing"
    [[ -d "$nvim_runtime/syntax" ]] && print_status "Neovim runtime: $nvim_runtime" || doctor_error "Neovim runtime missing or incomplete: $nvim_runtime"
    [[ -d "$nvim_data/lazy/lazy.nvim" ]] && print_status "lazy.nvim payload: $nvim_data/lazy/lazy.nvim" || doctor_error "lazy.nvim payload missing: $nvim_data/lazy/lazy.nvim"
    [[ -d "$nvim_data/lazy/LazyVim" ]] && print_status "LazyVim payload: $nvim_data/lazy/LazyVim" || doctor_error "LazyVim payload missing: $nvim_data/lazy/LazyVim"
    [[ -f "$nvim_data/lazy-lock.json" ]] && print_status "LazyVim lockfile: $nvim_data/lazy-lock.json" || doctor_error "LazyVim lockfile missing: $nvim_data/lazy-lock.json"
    if [[ -x "${BIN_DIR:-$HOME/.local/bin}/nvim" && -d "$nvim_data/lazy/lazy.nvim" && -d "$nvim_data/lazy/LazyVim" && -d "$nvim_runtime/syntax" ]]; then
        startup_output=$(mktemp "${TMPDIR:-/tmp}/airgap-dev-kit-doctor-nvim.XXXXXX")
        if VIMRUNTIME="$nvim_runtime" "${BIN_DIR:-$HOME/.local/bin}/nvim" --headless '+lua assert(pcall(require, "lazy"), "cannot load lazy.nvim")' '+qa' >"$startup_output" 2>&1; then
            print_status "Neovim headless startup and lazy.nvim load succeeded"
            if [[ -s "$startup_output" ]]; then
                doctor_warning "Neovim startup emitted diagnostics (often optional toolchain checks):"
                sed 's/^/  /' "$startup_output"
            fi
        else
            doctor_error "Neovim headless startup failed; inspect $state_home/nvim/lazy.log"
            sed 's/^/  /' "$startup_output"
        fi
        rm -f "$startup_output"
    fi

    echo ""
    echo "Mason payload:"
    [[ -x "$mason_dir/node/bin/node" ]] && print_status "Bundled Mason Node runtime: $mason_dir/node/bin/node" || doctor_error "Bundled Mason Node runtime missing: $mason_dir/node/bin/node"
    if [[ -f "$KIT_DIR/config/plugin-manifest.lua" ]]; then
        while IFS= read -r package; do
            [[ -n "$package" ]] || continue
            [[ -d "$mason_dir/packages/$package" ]] && print_status "Mason package: $package" || doctor_error "Mason package missing: $package ($mason_dir/packages/$package)"
        done < <(awk '
            /^[[:space:]]*mason[[:space:]]*=/ { in_mason = 1; next }
            in_mason && /^[[:space:]]*lazyvim_extras[[:space:]]*=/ { exit }
            in_mason { sub(/--.*/, ""); if (match($0, /"[^"]+"/)) { value = substr($0, RSTART + 1, RLENGTH - 2); print value } }
        ' "$KIT_DIR/config/plugin-manifest.lua")
    fi
    if [[ -d "$state_home/airgap-dev-kit/transactions" ]]; then print_status "Installation transactions retained"; else doctor_warning "No installation transaction history"; fi
    [[ -d "$data_home/airgap-dev-kit/backups" ]] && doctor_warning "Neovim backups are available for recovery"
    echo ""
    [[ $warnings -eq 0 ]] || print_warning "Doctor completed with $warnings warning(s)"
    [[ $failures -eq 0 ]] && print_status "Doctor completed: all required installed components are healthy"
    [[ $failures -eq 0 ]] || return 1
}

# Function to install from offline packages
install_tools() {
    print_header "Installing Air-Gap Dev Kit Tools"
    
    if [[ -f "$KIT_DIR/install.sh" ]]; then
        print_status "Running installation script..."
        cd "$KIT_DIR"
        bash install.sh
    else
        print_error "install.sh not found. Are you in the correct directory?"
        exit 1
    fi
}

# Function to remove installation
remove_installation() {
    print_header "Removing Air-Gap Dev Kit"
    
    if can_use_gum_prompts; then
        gum style --foreground=red "⚠ This will completely remove the Air-Gap Dev Kit!"
        if ! confirm_action "Are you sure you want to continue?"; then
            print_warning "Removal cancelled."
            exit 0
        fi
    fi
    
    if [[ -f "$KIT_DIR/uninstall.sh" ]]; then
        show_progress "Running uninstallation script" 3
        cd "$KIT_DIR"
        bash uninstall.sh
        print_status "Air-Gap Dev Kit removed successfully!"
    else
        print_warning "uninstall.sh not found. Manual removal may be required."
        print_status "To manually remove, delete the installation directory and binaries from $BIN_DIR"
    fi
}

# Function to show status
show_status() {
    print_header "Air-Gap Dev Kit Status"
    
    if [[ -f "$KIT_DIR/Makefile" ]] && command -v make >/dev/null 2>&1; then
        cd "$KIT_DIR"
        make status 2>/dev/null || print_warning "Could not run make status"
    else
        print_warning "Makefile or make command not available"
        
        # Basic status check
        echo ""
        echo "Basic Installation Check:"
        
        local tools=("wezterm" "tmux" "nvim" "fzf" "fd" "rg" "bat" "starship" "gdu" "usbtree" "glow" "broot" "fastfetch" "mkcert")
        
        for tool in "${tools[@]}"; do
            if command -v "$tool" >/dev/null 2>&1; then
                version=$("$tool" --version 2>/dev/null | head -1 || echo "unknown")
                echo "  ✓ $tool: $version"
            else
                echo "  ✗ $tool: not found"
            fi
        done
    fi
}

# Main command handling
case "${1:-help}" in
    version|--version|-v)
        show_version
        ;;
    check-update)
        check_update
        ;;
    download-release)
        shift
        download_release "$@"
        ;;
    apply-release)
        shift
        apply_release "$@"
        ;;
    update)
        shift
        update_release "$@"
        ;;
    refresh-sources)
        refresh_sources
        ;;
    doctor)
        doctor
        ;;
    install)
        install_tools
        ;;
    remove|uninstall)
        remove_installation
        ;;
    status)
        show_status
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        print_error "Unknown command: $1"
        echo ""
        show_help
        exit 1
        ;;
esac
