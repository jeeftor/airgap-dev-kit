#!/usr/bin/env bash
set -euo pipefail

IMAGE="${DOCKER_TEST_IMAGE:-ubuntu:22.04}"
PLATFORM="${DOCKER_TEST_PLATFORM:-linux/amd64}"
TARBALL="${1:-airgap-dev-kit-linux-x86_64.tar.gz}"
RUN_ID="$(date +%Y%m%d%H%M%S)-$$"

if [[ ! -f "$TARBALL" ]]; then
  echo "Missing package: $TARBALL" >&2
  echo "Run: make package" >&2
  exit 1
fi

cleanup_container() {
  local name="$1"
  docker rm -f "$name" >/dev/null 2>&1 || true
}

new_container() {
  local name="$1"
  cleanup_container "$name"
  docker create --platform "$PLATFORM" --name "$name" "$IMAGE" sleep infinity >/dev/null
  docker cp "$TARBALL" "$name:/tmp/airgap-dev-kit.tar.gz"
  docker start "$name" >/dev/null
}

run_case() {
  local name="$1"
  local command="$2"
  local container="airgap-${name}-${RUN_ID}"
  local full_command

  echo "==> $name"
  new_container "$container"
  full_command="${SMOKE_HELPERS}${command}"
  if docker exec "$container" bash -lc "$full_command"; then
    cleanup_container "$container"
    echo "✓ $name"
  else
    echo "✗ $name failed; container left for inspection: $container" >&2
    docker exec "$container" bash -lc 'tail -80 /tmp/install.out /tmp/nvim-headless.out /tmp/doctor-installed.out /tmp/remove.out 2>/dev/null' || true
    return 1
  fi
}

# shellcheck disable=SC2016
SMOKE_HELPERS='
app_smoke() {
echo "hello airgap" > /tmp/airgap-smoke.txt
if tmux -V >/tmp/tmux-version.out 2>/tmp/tmux-version.err; then
  cat /tmp/tmux-version.out
elif head -c 10 "$(command -v tmux)" | od -An -tx1 | grep -q "41 49"; then
  echo "tmux AppImage artifact present; Docker emulation cannot execute AppImage header"
else
  cat /tmp/tmux-version.err
  exit 1
fi
nvim --headless "+qa" >/tmp/nvim-headless.out 2>&1
nvim --version | head -1
fzf --version
fd airgap /tmp
rg "hello airgap" /tmp/airgap-smoke.txt
bat --version
starship --version | grep -q "^starship "
starship prompt >/tmp/starship-prompt.out
test -s /tmp/starship-prompt.out
lsd --version
lazygit --version
zoxide --version
delta --version
difft --version
jq --version
btop --version
direnv --version
dust --version
gdu --version
usbtree --version
mkcert --version
svu --version
"$HOME/.local/share/nvim/mason/bin/lua-language-server" --version
PATH="$HOME/.local/share/nvim/mason/node/bin:$PATH" "$HOME/.local/share/nvim/mason/bin/bash-language-server" --version
shellcheck --version
gum --version
glow --version
gum style --border double --border-foreground 42 --padding "1 2" --bold "Air-Gap Dev Kit" >/tmp/gum-style.out
test -s /tmp/gum-style.out
printf "# Offline Markdown\n\nYour kit is ready.\n" | glow - >/tmp/glow-render.out
grep -q "Offline Markdown" /tmp/glow-render.out
test -f "$HOME/.local/share/applications/airgap-wezterm.desktop"
grep -F "Exec=\"$HOME/.local/bin/wezterm\" start" "$HOME/.local/share/applications/airgap-wezterm.desktop"
}

'

# shellcheck disable=SC2016
BASE_INSTALL_REMOVE='
set -euo pipefail
rm -rf /tmp/smoke
mkdir /tmp/smoke
tar -xzf /tmp/airgap-dev-kit.tar.gz -C /tmp/smoke >/tmp/extract.out 2>/tmp/extract.err
cd /tmp/smoke/airgap-dev-kit
./airgap install --yes --nvim-mode=replace > /tmp/install.out 2>&1
export PATH="$HOME/.local/bin:$PATH"
app_smoke
airgap version > /tmp/cli-version.out
cd /tmp
unset AIRGAP_KIT_DIR
airgap doctor --verify > /tmp/doctor-installed.out
airgap status > /tmp/cli-status.out
"/tmp/smoke/airgap-dev-kit/airgap" uninstall --yes > /tmp/remove.out 2>&1
test ! -f "$HOME/.local/share/applications/airgap-wezterm.desktop"
hash -r
if command -v starship >/dev/null 2>&1; then
  echo "starship still installed"
  exit 1
fi
if command -v airgap-dev-kit >/dev/null 2>&1; then
  echo "airgap-dev-kit still installed"
  exit 1
fi
'

# shellcheck disable=SC2016
BASH_SHELL_CONFIG='
set -euo pipefail
rm -rf /tmp/smoke
mkdir /tmp/smoke
tar -xzf /tmp/airgap-dev-kit.tar.gz -C /tmp/smoke >/tmp/extract.out 2>/tmp/extract.err
rm -f /root/.zshrc
touch /root/.bashrc
cd /tmp/smoke/airgap-dev-kit
./airgap install --yes --nvim-mode=replace > /tmp/install.out 2>&1
grep -F "/airgap-dev-kit/shell.sh" /root/.bashrc
export PATH="$HOME/.local/bin:$PATH"
app_smoke
bash -lc "source /root/.bashrc >/tmp/bash-source.out 2>/tmp/bash-source.err; command -v starship >/dev/null; starship prompt >/tmp/bash-starship-prompt.out"
test -s /tmp/bash-starship-prompt.out
./airgap uninstall --yes > /tmp/remove.out 2>&1
! grep -q "/airgap-dev-kit/shell.sh" /root/.bashrc
'

# shellcheck disable=SC2016
ZSH_SHELL_CONFIG='
set -euo pipefail
for attempt in 1 2 3; do
  if apt-get update -qq >/tmp/apt-update.out 2>&1; then
    break
  fi
  if [[ "$attempt" -eq 3 ]]; then
    echo "apt-get update failed after 3 attempts"
    cat /tmp/apt-update.out
    exit 1
  fi
  sleep 3
done
for attempt in 1 2 3; do
  if DEBIAN_FRONTEND=noninteractive apt-get install -y -qq zsh >/tmp/apt-install.out 2>&1; then
    break
  fi
  if [[ "$attempt" -eq 3 ]]; then
    echo "apt-get install zsh failed after 3 attempts"
    cat /tmp/apt-install.out
    exit 1
  fi
  sleep 3
done
rm -rf /tmp/smoke
mkdir /tmp/smoke
tar -xzf /tmp/airgap-dev-kit.tar.gz -C /tmp/smoke >/tmp/extract.out 2>/tmp/extract.err
rm -f /root/.bashrc
touch /root/.zshrc
cd /tmp/smoke/airgap-dev-kit
SHELL=/bin/zsh ./airgap install --yes --nvim-mode=replace > /tmp/install.out 2>&1
grep -F "/airgap-dev-kit/shell.sh" /root/.zshrc
export PATH="$HOME/.local/bin:$PATH"
app_smoke
zsh -ic "command -v starship >/dev/null; starship prompt >/tmp/zsh-starship-prompt.out" 2>/tmp/zsh-shell.err
test -s /tmp/zsh-starship-prompt.out
./airgap uninstall --yes > /tmp/remove.out 2>&1
! grep -q "/airgap-dev-kit/shell.sh" /root/.zshrc
'

run_case "install-remove" "$BASE_INSTALL_REMOVE"
run_case "bash-shell" "$BASH_SHELL_CONFIG"
run_case "zsh-shell" "$ZSH_SHELL_CONFIG"

echo "✓ Docker smoke tests passed"
