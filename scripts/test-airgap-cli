#!/bin/bash

# Test script for airgap-dev-kit CLI
# This script tests all functionality of the airgap-dev-kit command

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

TESTS_PASSED=0
TESTS_FAILED=0

# Test functions
test_passed() {
    echo -e "${GREEN}✓ PASS${NC} $1"
    ((TESTS_PASSED++))
}

test_failed() {
    echo -e "${RED}✗ FAIL${NC} $1"
    ((TESTS_FAILED++))
}

test_info() {
    echo -e "${BLUE}ℹ INFO${NC} $1"
}

test_warning() {
    echo -e "${YELLOW}⚠ WARN${NC} $1"
}

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AIRGAP_CLI="$SCRIPT_DIR/airgap-dev-kit"

# Test 1: Script exists and is executable
test_info "Test 1: Checking if airgap-dev-kit script exists and is executable..."
if [[ -f "$AIRGAP_CLI" ]] && [[ -x "$AIRGAP_CLI" ]]; then
    test_passed "Script exists and is executable"
else
    test_failed "Script not found or not executable"
    exit 1
fi

# Test 2: Help command works
test_info "Test 2: Testing help command..."
if "$AIRGAP_CLI" help >/dev/null 2>&1; then
    test_passed "Help command works"
else
    test_failed "Help command failed"
fi

# Test 3: Version command works
test_info "Test 3: Testing version command..."
if "$AIRGAP_CLI" version >/dev/null 2>&1; then
    test_passed "Version command works"
else
    test_failed "Version command failed"
fi

# Test 4: Status command works
test_info "Test 4: Testing status command..."
if "$AIRGAP_CLI" status >/dev/null 2>&1; then
    test_passed "Status command works"
else
    test_failed "Status command failed"
fi

# Test 5: Invalid command handling
test_info "Test 5: Testing invalid command handling..."
if ! "$AIRGAP_CLI" invalid-command >/dev/null 2>&1; then
    test_passed "Invalid command properly rejected"
else
    test_failed "Invalid command not properly rejected"
fi

# Test 6: Gum integration (if available)
test_info "Test 6: Testing gum integration..."
if command -v gum >/dev/null 2>&1; then
    # Check if the script detects gum
    if "$AIRGAP_CLI" version 2>&1 | grep -q "Gum UI enhancements available"; then
        test_passed "Gum integration working"
    else
        test_failed "Gum integration not working"
    fi
else
    test_warning "Gum not available, skipping gum integration test"
fi

# Test 7: Script syntax validation
test_info "Test 7: Testing script syntax..."
if bash -n "$AIRGAP_CLI" 2>/dev/null; then
    test_passed "Script syntax is valid"
else
    test_failed "Script syntax errors found"
fi

# Test 8: Check required functions exist
test_info "Test 8: Testing required functions..."
required_functions=("print_status" "print_warning" "print_error" "print_header" "show_help" "show_version")
missing_functions=()

for func in "${required_functions[@]}"; do
    if ! grep -q "^[[:space:]]*$func[[:space:]]*(" "$AIRGAP_CLI"; then
        missing_functions+=("$func")
    fi
done

if [[ ${#missing_functions[@]} -eq 0 ]]; then
    test_passed "All required functions present"
else
    test_failed "Missing functions: ${missing_functions[*]}"
fi

# Test 9: Check for proper error handling
test_info "Test 9: Testing error handling..."
# Test with non-existent directory (should fail gracefully)
if cd /tmp/non-existent-directory 2>/dev/null; then
    test_failed "Should have failed with non-existent directory"
else
    if "$AIRGAP_CLI" status >/dev/null 2>&1; then
        test_passed "Error handling works correctly"
    else
        test_failed "Error handling not working correctly"
    fi
fi

# Test 10: Check script in different contexts
test_info "Test 10: Testing script portability..."
# Test from different directory
cd /tmp
if "$AIRGAP_CLI" version >/dev/null 2>&1; then
    test_passed "Script works from different directory"
else
    test_failed "Script fails from different directory"
fi

# Return to script directory
cd "$SCRIPT_DIR"

# Summary
echo ""
echo "=================================="
echo "Test Summary:"
echo -e "${GREEN}Tests Passed: $TESTS_PASSED${NC}"
echo -e "${RED}Tests Failed: $TESTS_FAILED${NC}"
echo -e "${BLUE}Total Tests: $((TESTS_PASSED + TESTS_FAILED))${NC}"
echo "=================================="

if [[ $TESTS_FAILED -eq 0 ]]; then
    echo -e "${GREEN}✓ All tests passed!${NC}"
    exit 0
else
    echo -e "${RED}✗ Some tests failed!${NC}"
    exit 1
fi
