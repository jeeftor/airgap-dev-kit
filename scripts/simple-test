#!/bin/bash

# Simple test for airgap-dev-kit CLI
echo "Testing airgap-dev-kit CLI..."

# Test 1: Check if script exists
if [[ -f "./scripts/airgap-dev-kit" ]]; then
    echo "✓ Script exists"
else
    echo "✗ Script not found"
    exit 1
fi

# Test 2: Check if script is executable
if [[ -x "./scripts/airgap-dev-kit" ]]; then
    echo "✓ Script is executable"
else
    echo "✗ Script is not executable"
    exit 1
fi

# Test 3: Check script syntax
if bash -n "./scripts/airgap-dev-kit" 2>/dev/null; then
    echo "✓ Script syntax is valid"
else
    echo "✗ Script syntax error"
    exit 1
fi

# Test 4: Test help command
if bash "./scripts/airgap-dev-kit" help >/dev/null 2>&1; then
    echo "✓ Help command works"
else
    echo "✗ Help command failed"
fi

# Test 5: Test version command
if bash "./scripts/airgap-dev-kit" version >/dev/null 2>&1; then
    echo "✓ Version command works"
else
    echo "✗ Version command failed"
fi

echo "Basic tests completed!"
